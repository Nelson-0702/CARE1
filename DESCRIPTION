Package: CARE1
Type: Package
Title: Population Size Estimation for Both Animal and Human Populations Using Capture-Recapture Models
Version: 1.1.1
Authors@R:
    c(person("Anne", "Chao",
             role = c("aut", "cre"),
             email = "chao@stat.nthu.edu.tw"),
